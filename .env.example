NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# International format, digits only (used for WhatsApp checkout)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional email notifications (https://resend.com). Leave blank to disable.
RESEND_API_KEY=key
ADMIN_NOTIFY_EMAIL=
# Use an address on a domain verified in Resend for production
NOTIFY_FROM=PhayiHairline <orders@yourdomain.com>

# Optional: public social profiles (shown in the footer and in Google structured data)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
